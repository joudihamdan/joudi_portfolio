# Telegram contact-form settings (SERVER-SIDE ONLY).
# Copy this file to ".env" for local dev and fill in real values.
# In production, set these in your host's dashboard (e.g. Vercel > Settings > Environment Variables).
#
# IMPORTANT: do NOT prefix these with VITE_. Anything prefixed VITE_ is bundled
# into the browser build and would leak your bot token to the public.
# Make sure ".env" is listed in .gitignore so it is never committed.

TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
